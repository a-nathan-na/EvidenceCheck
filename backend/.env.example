# Copy to .env and adjust. All values shown are the defaults.

# Ultralytics model. yolov8s.pt / yolov8m.pt are slower but more accurate.
EVIDENCECHECK_MODEL=yolov8n.pt

# Minimum detection confidence, 0.0-1.0.
EVIDENCECHECK_CONFIDENCE=0.5

# Frames sampled per second of video.
EVIDENCECHECK_SAMPLE_FPS=1

# Annotated frames returned in the response.
EVIDENCECHECK_MAX_FRAMES=3

# Comma-separated browser origins allowed to call the API.
EVIDENCECHECK_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
